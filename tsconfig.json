{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true, // for 'JSX' namespace in @types/mdx/types.d.ts
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "noEmit": true,
    "noImplicitReturns": true,
    "noImplicitThis": false,
    "types": ["@testing-library/jest-dom"]
  },
  "include": ["src", "tests"]
}
